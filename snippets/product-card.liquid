{%- comment -%}
Renders a product card: image, title, price.
Accepts:
- card_product: {Object} product object (required)
{%- endcomment -%}


{%- liquid
assign target_variant = card_product.selected_or_first_available_variant
assign is_sale = false
if target_variant.compare_at_price > target_variant.price
assign is_sale = true
endif

assign badge_tag = ''
for tag in card_product.tags
if tag contains 'badge_'
assign badge_tag = tag | remove_first: 'badge_'
break
endif
endfor

assign badge_label = ''
if badge_tag != ''
assign badge_label = badge_tag | replace: '-', ' ' | capitalize
endif

assign style_class = ''
case settings.badge_style
  when 'glass'
    assign style_class = 'v-card__style--glass'
  else
    assign style_class = 'v-card__style--accent'
endcase

assign aspect_class = 'v-card__media--square'
case settings.card_aspect_ratio
  when 'portrait'
    assign aspect_class = 'v-card__media--portrait'
  when 'tall'
    assign aspect_class = 'v-card__media--tall'
  when 'landscape'
    assign aspect_class = 'v-card__media--landscape'
  when 'adapt'
    assign aspect_class = 'v-card__media--adapt'
  else
    assign aspect_class = 'v-card__media--square'
endcase

assign card_media_list = card_product.media | slice: 0, 5
assign card_media_count = card_media_list.size

assign has_variants = false
if card_product.has_only_default_variant == false
  assign has_variants = true
endif

assign main_option_values = blank
assign remaining_variant_count = 0
if has_variants
  assign main_option_values = card_product.options_with_values.first.values
  assign visible_variant_values = main_option_values | slice: 0, 4
  assign remaining_variant_count = main_option_values.size | minus: 4
endif

-%}

<div class="v-card" data-v-product-card>
    <a href="{{ card_product.url }}" class="v-card__link">
        <div class="v-card__media {{ aspect_class }}" style="border-radius: {{ settings.card_media_radius }}px; --v-card-control-radius: {{ settings.quick_add_pagination_radius }}px;">
            <button type="button" class="v-card__quick-view{% if settings.enable_glass_effect %} v-card__quick-view--glass{% endif %} accent-button"
                {% if has_variants %}data-quick-view-open{% else %}data-quick-add-open{% endif %}
                data-product-id="{{ card_product.id }}" data-variant-id="{{ target_variant.id }}"
                aria-label="{% if has_variants %}{{ 'products.card.quick_view' | t }}{% else %}{{ 'products.card.quick_add' | t }}{% endif %}"
                onclick="event.preventDefault();">
                <span class="v-card__quick-view-icon">
                  {%- if has_variants -%}
                  {{ 'icon-quick-view.svg' | inline_asset_content }}
                  {%- else -%}
                  {{ 'icon-plus.svg' | inline_asset_content }}
                  {%- endif -%}
                </span>
            </button>
            {%- if settings.show_sale_badge and is_sale or settings.show_custom_badge and badge_label != '' -%}
            <div class="v-card__badges">
                {%- if settings.show_sale_badge and is_sale -%}
                <span class="v-card__badge {{ style_class }} v-card__badge--sale">
                    <small class="v-card__badge-text">{{ 'products.card.sale_badge' | t }}</small>
                </span>
                {%- endif -%}
                {%- if settings.show_custom_badge and badge_label != '' -%}
                <small class="v-card__badge {{ style_class }} v-card__badge--custom">{{ badge_label }}</small>
                {%- endif -%}
            </div>
            {%- endif -%}

            {%- if card_media_count > 0 -%}
            <div class="v-card__swiper swiper" data-card-swiper>
                <div class="swiper-wrapper">
                    {%- for media in card_media_list -%}
                    <div class="swiper-slide v-card__slide">
                        {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                        {%- if media.media_type == 'video' -%}
                        {{ media | video_tag: image_size: '1000x', muted: true, loop: true, controls: false, class: 'v-card__img v-card__video' }}
                        {%- else -%}
                        <div class="v-card__external-video" data-external-video>
                          {{ media | external_video_tag: image_size: '1000x', class: 'v-card__img v-card__video-iframe' }}
                        </div>
                        {%- endif -%}
                        {%- else -%}
                        {{ media | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '300,450,600,800,1000', sizes: '(min-width: 990px) 25vw, 50vw', class: 'v-card__img' }}
                        {%- endif -%}
                    </div>
                    {%- endfor -%}
                </div>
                {%- if card_media_count > 1 -%}
                <div class="v-card__pagination{% if settings.enable_glass_effect %} v-card__pagination--glass{% endif %}"></div>
                {%- endif -%}
            </div>
            {%- else -%}
            <div class="placeholder-image">{{ 'placeholder-media.svg' | inline_asset_content }}</div>
            {%- endif -%}

            
        </div>

        <div class="v-card__info">
            {%- if settings.show_vendor and card_product.vendor != blank -%}
            <p class="v-card__vendor">{{ card_product.vendor }}</p>
            {%- endif -%}
            <h5 class="v-card__title">{{ card_product.title }}</h5>
            {% render 'price', product: card_product %}
            {%- if has_variants and main_option_values.size > 1 -%}
            <div class="v-card__variants" style="--v-card-swatch-radius: {{ settings.variant_swatch_radius }}px;">
                {%- for value in visible_variant_values -%}
                {%- assign matched_variant = blank -%}
                {%- for v in card_product.variants -%}
                  {%- if v.option1 == value or v.option2 == value or v.option3 == value -%}
                    {%- assign matched_variant = v -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                <span class="v-card__variant-swatch{% if matched_variant.featured_image == blank %} v-card__variant-swatch--text{% endif %}" data-variant-value="{{ value | escape }}" title="{{ value | escape }}">
                  {%- if matched_variant.featured_image != blank -%}
                  {{ matched_variant.featured_image | image_url: width: 60 | image_tag: loading: 'lazy', class: 'v-card__variant-swatch-img' }}
                  {%- else -%}
                  <span class="v-card__variant-swatch-text">{{ value }}</span>
                  {%- endif -%}
                </span>
                {%- endfor -%}
                {%- if remaining_variant_count > 0 -%}
                <span class="v-card__variant-more">
                    {{ 'icon-plus.svg' | inline_asset_content }}
                </span>
                {%- endif -%}
            </div>
            {%- endif -%}
        </div>
    </a>
</div>

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script src="{{ 'product-card.js' | asset_url }}" defer></script>


{{ 'video-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
#v-video-{{ section.id }} {
  --v-video-height-desktop: {{ section.settings.height_desktop }}px;
  --v-video-height-mobile: {{ section.settings.height_mobile }}px;
  --v-video-overlay-opacity: {{ section.settings.overlay_opacity | default: 0 | divided_by: 100.0 }};
}
{%- endstyle -%}

{% assign v_video_styles = '--v-video-height-desktop: '
  | append: section.settings.height_desktop
  | append: 'px; --v-video-height-mobile: '
  | append: section.settings.height_mobile
  | append: 'px; --v-video-overlay-opacity: '
  | append: section.settings.overlay_opacity | default: 0 | divided_by: 100.0
  | append: ';'
%}

{% assign position_style = '' %}
{% assign device_list = 'desktop,mobile' | split: ',' %}
{% for device in device_list %}
  {% assign position_key = 'content_position_' | append: device %}
  {% assign pos = section.settings[position_key] | split: '_' %}
  {% assign align = 'center' %}
  {% if pos[0] == 'top' -%}
    {%- assign align = 'flex-start' %}
  {% elsif pos[0] == 'bottom' -%}
    {%- assign align = 'flex-end' -%}
  {%- endif %}
  {% assign justify = 'center' %}
  {% if pos[1] == 'left' -%}
    {%- assign justify = 'flex-start' -%}
  {% elsif pos[1] == 'right' -%}
    {%- assign justify = 'flex-end' -%}
  {%- endif %}
  {% assign position_style = position_style
    | append: '--v-video-align-'
    | append: device
    | append: ': '
    | append: align
    | append: '; --v-video-justify-'
    | append: device
    | append: ': '
    | append: justify
    | append: '; '
  %}
{% endfor %}

{% assign content_justify_value = 'center' %}
{% case section.settings.content_alignment %}
  {% when 'left' -%}
    {%- assign content_justify_value = 'flex-start' %}
  {% when 'right' -%}
    {%- assign content_justify_value = 'flex-end' %}
{% endcase %}
{% assign content_alignment_style = '--v-video-content-text-align: '
  | append: section.settings.content_alignment
  | append: '; --v-video-content-justify: '
  | append: content_justify_value
  | append: ';'
%}

{% assign text_color_class = 'v-video__text--light' %}
{% if section.settings.text_color == 'dark' %}
  {% assign text_color_class = 'v-video__text--dark' %}
{% endif %}

<div
  class="v-video section-color-scheme--{{ section.settings.section_color_scheme | default: 'scheme_1' }}"
  id="v-video-{{ section.id }}"
  data-v-video-hero
  data-autoplay="{{ section.settings.enable_autoplay }}"
  style="{{ position_style }}"
>
  <div class="v-video__media">
    {%- comment -%} MOBILE POSTER — falls back to desktop {%- endcomment -%}
    <div class="v-video__poster v-video__poster--mobile">
      {%- if section.settings.poster_mobile != blank -%}
        {{ section.settings.poster_mobile | image_url: width: 1500 | image_tag: loading: 'eager', widths: '480,750,1000,1500', sizes: '100vw', class: 'v-video__poster-img' }}
      {%- elsif section.settings.poster_desktop != blank -%}
        {{ section.settings.poster_desktop | image_url: width: 1500 | image_tag: loading: 'eager', widths: '480,750,1000,1500', sizes: '100vw', class: 'v-video__poster-img' }}
      {%- endif -%}
    </div>
    <div class="v-video__poster v-video__poster--desktop">
      {%- if section.settings.poster_desktop != blank -%}
        {{ section.settings.poster_desktop | image_url: width: 3840 | image_tag: loading: 'eager', widths: '750,1500,2560,3840', sizes: '100vw', class: 'v-video__poster-img' }}
      {%- endif -%}
    </div>

    {%- comment -%} MOBILE VIDEO — falls back to desktop {%- endcomment -%}
    <div class="v-video__video-wrap v-video__video-wrap--mobile">
      {%- if section.settings.video_mobile != blank -%}
        {{ section.settings.video_mobile | video_tag: image_size: '1500x', muted: true, loop: true, controls: false, autoplay: section.settings.enable_autoplay, class: 'v-video__video' }}
      {%- elsif section.settings.video_desktop != blank -%}
        {{ section.settings.video_desktop | video_tag: image_size: '1500x', muted: true, loop: true, controls: false, autoplay: section.settings.enable_autoplay, class: 'v-video__video' }}
      {%- endif -%}
    </div>
    <div class="v-video__video-wrap v-video__video-wrap--desktop">
      {%- if section.settings.video_desktop != blank -%}
        {{ section.settings.video_desktop | video_tag: image_size: '3840x', muted: true, loop: true, controls: false, autoplay: section.settings.enable_autoplay, class: 'v-video__video' }}
      {%- endif -%}
    </div>
  </div>

  <div class="v-video__overlay"></div>

  <div class="v-video__content{% if section.settings.full_width %} full-width{% else %} container-width{% endif %}">
    <div data-animate="fade-up" data-animate-delay="440" class="v-video__content-inner" style="{{ content_alignment_style }} ">
      <div class="v-video__text {{ text_color_class }}">
        {%- if section.settings.subheading != blank -%}
          <p class="v-video__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          {%- case section.settings.heading_tag -%}
            {%- when 'h1' -%}
              <h1 class="v-video__heading">{{ section.settings.heading }}</h1>
            {%- when 'h3' -%}
              <h3 class="v-video__heading">{{ section.settings.heading }}</h3>
            {%- when 'h4' -%}
              <h4 class="v-video__heading">{{ section.settings.heading }}</h4>
            {%- when 'h5' -%}
              <h5 class="v-video__heading">{{ section.settings.heading }}</h5>
            {%- else -%}
              <h2 class="v-video__heading">{{ section.settings.heading }}</h2>
          {%- endcase -%}
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="v-video__description">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <div class="v-video__buttons">
          <a href="{{ section.settings.button_link }}" class="button {% if section.settings.button_style == 'outline' %}button--outline{% else %}button--filled{% endif %}">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>

  <button type="button" class="v-video__mute-btn" aria-label="Mute video">
    <span class="v-video__icon v-video__icon--unmuted">{{ 'icon-volume.svg' | inline_asset_content }}</span>
    <span class="v-video__icon v-video__icon--muted">{{ 'icon-mute.svg' | inline_asset_content }}</span>
  </button>

  <button type="button" class="v-video__play-btn" aria-label="Play video">
    <span class="v-video__icon v-video__icon--play">{{ 'icon-play.svg' | inline_asset_content }}</span>
    <span class="v-video__icon v-video__icon--stop">{{ 'icon-stop.svg' | inline_asset_content }}</span>
  </button>
</div>

<script src="{{ 'video-hero.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Video hero",
  "class": "section-video-hero",
  "settings": [
    {
      "type": "select",
      "id": "section_color_scheme",
      "label": "Color scheme",
      "default": "scheme_1",
      "options": [
        { "value": "scheme_1", "label": "Scheme 1" },
        { "value": "scheme_2", "label": "Scheme 2" },
        { "value": "scheme_3", "label": "Scheme 3" },
        { "value": "scheme_4", "label": "Scheme 4" }
      ]
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Height — desktop",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height — mobile",
      "min": 250,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 450
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    { "type": "header", "content": "Video — desktop" },
    { "type": "video", "id": "video_desktop", "label": "Video" },
    { "type": "image_picker", "id": "poster_desktop", "label": "Poster image" },
    { "type": "header", "content": "Video — mobile" },
    { "type": "video", "id": "video_mobile", "label": "Video", "info": "Falls back to desktop video if empty" },
    { "type": "image_picker", "id": "poster_mobile", "label": "Poster image", "info": "Falls back to desktop poster if empty" },
    { "type": "header", "content": "Playback" },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Autoplay",
      "default": true
    },
    { "type": "header", "content": "Content position" },
    {
      "type": "select",
      "id": "content_position_desktop",
      "label": "Position — desktop",
      "default": "center_center",
      "options": [
        { "value": "top_left", "label": "Top left" },
        { "value": "top_center", "label": "Top center" },
        { "value": "top_right", "label": "Top right" },
        { "value": "center_left", "label": "Center left" },
        { "value": "center_center", "label": "Center center" },
        { "value": "center_right", "label": "Center right" },
        { "value": "bottom_center", "label": "Bottom center" }
      ]
    },
    {
      "type": "select",
      "id": "content_position_mobile",
      "label": "Position — mobile",
      "default": "center_center",
      "options": [
        { "value": "top_left", "label": "Top left" },
        { "value": "top_center", "label": "Top center" },
        { "value": "top_right", "label": "Top right" },
        { "value": "center_left", "label": "Center left" },
        { "value": "center_center", "label": "Center center" },
        { "value": "center_right", "label": "Center right" },
        { "value": "bottom_center", "label": "Bottom center" }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text color",
      "default": "light",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ]
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Video heading" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "info": "Controls the HTML tag used for SEO/accessibility. Visual size is unaffected.",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" }
      ]
    },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "filled",
      "options": [
        { "value": "filled", "label": "Filled" },
        { "value": "outline", "label": "Outline" }
      ]
    }
  ],
  "presets": [{ "name": "Video hero" }]
}
{% endschema %}
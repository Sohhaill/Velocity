{{ 'featured-collection.css' | asset_url | stylesheet_tag }}

{%- style -%}
#v-featured-collection-{{ section.id }} {
--v-fc-columns-desktop: {{ section.settings.columns_desktop }};
--v-fc-columns-mobile: {{ section.settings.columns_mobile }};
--v-fc-gap-desktop: {{ section.settings.gap_desktop }}px;
--v-fc-gap-mobile: {{ section.settings.gap_mobile }}px;
}
{%- endstyle -%}
<div class="section-color-scheme--{{ section.settings.section_color_scheme.id }}" >
<div class="v-featured-collection  {% if section.settings.container_width %} container-width{% endif %}"
    id="v-featured-collection-{{ section.id }}">
    {%- if section.settings.heading != blank -%}
    <h2 class="v-featured-collection__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="v-featured-collection__grid">
        {%- for card_product in section.settings.collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', card_product: card_product %}
        {%- endfor -%}
    </div>
</div>
</div>
{% schema %}
{
"name": "Featured collection",
"class": "section-featured-collection",
"settings": [
{
"type": "color_scheme",
"id": "section_color_scheme",
"label": "t:labels.color_scheme",
"default": "scheme-1"
},
{
"type": "checkbox",
"id": "container_width",
"label": "Contain within container width",
"default": false
},
{ "type": "header", "content": "Content" },
{ "type": "text", "id": "heading", "label": "Heading", "default": "Featured collection" },
{ "type": "collection", "id": "collection", "label": "Collection" },
{
"type": "range",
"id": "products_to_show",
"label": "Products to show",
"min": 2,
"max": 24,
"step": 1,
"default": 8
},
{ "type": "header", "content": "Grid" },
{
"type": "range",
"id": "columns_desktop",
"label": "Columns — desktop",
"min": 1,
"max": 6,
"step": 1,
"default": 4
},
{
"type": "range",
"id": "columns_mobile",
"label": "Columns — mobile",
"min": 1,
"max": 3,
"step": 1,
"default": 2
},
{
"type": "range",
"id": "gap_desktop",
"label": "Column gap — desktop",
"min": 0,
"max": 60,
"step": 2,
"unit": "px",
"default": 24
},
{
"type": "range",
"id": "gap_mobile",
"label": "Column gap — mobile",
"min": 0,
"max": 40,
"step": 2,
"unit": "px",
"default": 12
}
],
"presets": [
{
"name": "Featured collection",
"category": "Product"
}

]
}
{% endschema %}
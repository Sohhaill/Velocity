{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'insta-feed.css' | asset_url | stylesheet_tag }}

{% assign aspect_ratio_value = '1/1' %}
{% case section.settings.aspect_ratio %}
{% when '4_5' -%}
{%- assign aspect_ratio_value = '4/5' %}
{% when '3_4' -%}
{%- assign aspect_ratio_value = '3/4' %}
{% when '16_9' -%}
{%- assign aspect_ratio_value = '16/9' %}
{% when '9_16' -%}
{%- assign aspect_ratio_value = '9/16' %}
{% when '3_2' -%}
{%- assign aspect_ratio_value = '3/2' %}
{% endcase %}

{%- style -%}
#v-insta-{{ section.id }} {
--v-insta-aspect: {{ aspect_ratio_value }};
--v-insta-gap-desktop: {{ section.settings.gap_desktop }}px;
--v-insta-gap-mobile: {{ section.settings.gap_mobile }}px;
--v-insta-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
--v-insta-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
--v-insta-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
--v-insta-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
}
{%- endstyle -%}

<div
  class="v-insta section-color-scheme--{{ section.settings.section_color_scheme.id }}{% if section.settings.container_width %} container-width{% endif %}"
  id="v-insta-{{ section.id }}" data-v-insta data-slides-desktop="{{ section.settings.slides_per_view_desktop }}"
  data-slides-mobile="{{ section.settings.slides_per_view_mobile }}"
  data-gap-desktop="{{ section.settings.gap_desktop }}" data-gap-mobile="{{ section.settings.gap_mobile }}">
  <div class="v-insta__header">
    <div class="v-insta__header-text">
      {%- if section.settings.heading != blank -%}
      <h2 class="v-insta__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
      <p class="v-insta__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="v-insta__profile">
      {%- if section.settings.profile_image != blank -%}
      <a href="{{ section.settings.profile_url | default: '#' }}" class="v-insta__profile-avatar">
        {{ section.settings.profile_image | image_url: width: 100 | image_tag: loading: 'lazy', class:
        'v-insta__profile-img' }}
      </a>
      {%- endif -%}
      {%- if section.settings.profile_name != blank -%}
      <h6 class="v-insta__profile-name">{{
        section.settings.profile_name }}</h6>
      {%- endif -%}
      {%- if section.settings.follow_button_label != blank -%}

      <a href="{{ section.settings.profile_url | default: '#' }}"
        class="button v-insta__follow-btn {% if section.settings.follow_button_style == 'outline' %}button--outline{% else %}button--filled{% endif %}">
        {{ section.settings.follow_button_label }}
      </a>
      {%- endif -%}
    </div>
  </div>

  <div class="v-insta__swiper-wrap">
    <div class="v-insta__swiper swiper">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
        {%- if block.type == 'feed_item' -%}
        {% assign products = block.settings.products %}
        {% assign overlay_opacity_decimal = block.settings.overlay_opacity | default: 0 | divided_by: 100.0 %}
        {% assign overlay_style = '--overlay-opacity: ' | append: overlay_opacity_decimal | append: ';' %}
        <div class="swiper-slide v-insta__slide" data-animate="fade-up"
          data-animate-delay="{{ forloop.index0 | times: 150 }}" {{ block.shopify_attributes }}>
          <div class="v-insta__item">
            <div class="v-insta__media">
              {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: image_size: '1200x', muted: true, loop: true, autoplay: false,
              controls: false, class: 'v-insta__video' }}
              {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths:
              '400,600,800,1000,1200', sizes: '(min-width: 750px) 25vw, 60vw', class: 'v-insta__img' }}
              {%- else -%}
              <div class="placeholder-image">{{ 'placeholder-media.svg' | inline_asset_content }}</div>
              {%- endif -%}
            </div>
            <div class="v-insta__overlay" style="{{ overlay_style }}"></div>

            <span class="v-insta__badge">{{ 'icon-insta.svg' | inline_asset_content }}</span>

            {%- if products.size > 0 -%}
            <div class="v-insta__thumbs">
              <div class="v-insta__products">
                {%- for product in products limit: 4 -%}
                <span class="v-insta__thumb">
                  {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy', widths: '60,100',
                  class:
                  'v-insta__thumb-img' }}
                  {%- endif -%}
                </span>
                {%- endfor -%}
              </div>
              <button type="button" class="v-insta__shop-btn button--filled" data-insta-open
                data-target="insta-popup-{{ block.id }}">
                {{ section.settings.shop_button_label | default: 'Shop the Look' }}
              </button>
            </div>

            {%- endif -%}
          </div>
        </div>
        {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="v-insta__nav-container">
      {% assign nav_directions = 'prev,next' | split: ',' %}
      {%- for dir in nav_directions -%}
      {% assign nav_icon = 'icon-chevron-left.svg' %}
      {% if dir == 'next' %}
      {% assign nav_icon = 'icon-chevron-right.svg' %}
      {% endif %}
      <button type="button" class="v-insta__nav v-insta__nav--{{ dir }} button button--filled" aria-label="{{ dir }}">
        {{ nav_icon | inline_asset_content }}
      </button>
      {%- endfor -%}
    </div>
  </div>

  {%- for block in section.blocks -%}
  {%- if block.type == 'feed_item' -%}
  {% assign products = block.settings.products %}
  {%- if products.size > 0 -%}
  <div class="v-insta__popup section-color-scheme--{{ section.settings.section_color_scheme.id }}"
    id="insta-popup-{{ block.id }}" data-insta-popup>
    <div class="v-insta__popup-overlay" data-insta-close></div>
    <div class="v-insta__popup-inner">
      <div class="v-insta__popup-media">
        {%- if block.settings.image != blank -%}
        {{ block.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '600,900,1200,1500',
        sizes: '50vw', class: 'v-insta__popup-img' }}
        {%- elsif block.settings.video != blank -%}
        {{ block.settings.video | video_tag: image_size: '1500x', muted: true, loop: true, autoplay: true, controls:
        false, class: 'v-insta__popup-video' }}
        {%- else -%}
        <div class="placeholder-image">{{ 'placeholder-media.svg' | inline_asset_content }}</div>
        {%- endif -%}
      </div>

      <div class="v-insta__popup-panel">
        <div class="v-insta__popup-top">
          <h3 class="v-insta__popup-heading">{{ section.settings.heading }}</h3>
          <button type="button" class="v-insta__popup-close" data-insta-close aria-label="Close">
            {{ 'icon-close.svg' | inline_asset_content }}
          </button>
        </div>

        <div class="v-insta__popup-products">
          {%- for product in products -%}
          <div class="v-insta__popup-product">
            <a href="{{ product.url }}" class="v-insta__popup-product-media">
              {%- if product.featured_image -%}
              {{ product.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150,200,300',
              sizes: '100px', class: 'v-insta__popup-product-img' }}
              {%- endif -%}
            </a>
            <div class="v-insta__popup-product-info">
              <a href="{{ product.url }}" class="v-insta__popup-product-title">{{ product.title }}</a>
              <span class="v-insta__popup-product-price">
                {%- if product.compare_at_price > product.price -%}
                <s class="v-insta__popup-product-compare">{{ product.compare_at_price | money }}</s>
                {%- endif -%}
                {{ product.price | money }}
              </span>
            </div>
            <a href="{{ product.url }}" class="v-insta__popup-view button button--outline">+ View</a>
          </div>
          {%- endfor -%}
        </div>

        <div class="v-insta__popup-footer">
          {%- if section.settings.profile_image != blank -%}
          <div class="v-insta-popup-profile">
            {{ section.settings.profile_image | image_url: width: 100 | image_tag: loading: 'lazy', class:
            'v-insta__popup-footer-avatar' }}
          </div>
          {%- endif -%}
          <div class="v-insta__popup-footer-info">
            {%- if section.settings.profile_name != blank -%}
            <h6 class="v-insta__popup-footer-name">{{ section.settings.profile_name }}</h6>
            {%- endif -%}
            {%- if section.settings.profile_tagline != blank -%}
            <span class="v-insta__popup-footer-tagline">{{ section.settings.profile_tagline }}</span>
            {%- endif -%}
          </div>
          {%- if section.settings.follow_button_label != blank -%}
          <a href="{{ section.settings.profile_url | default: '#' }}"
            class="button v-insta__popup-follow {% if section.settings.follow_button_style == 'outline' %}button--outline{% else %}button--filled{% endif %}">
            {{ section.settings.follow_button_label }}
          </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
  {%- endif -%}
  {%- endif -%}
  {%- endfor -%}
</div>

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script src="{{ 'insta-feed.js' | asset_url }}" defer></script>

{% schema %}
{
"name": "Insta feed",
"class": "section-insta-feed",
"settings": [
{
"type": "color_scheme",
"id": "section_color_scheme",
"label": "t:labels.color_scheme",
"default": "scheme-1"
},
{
"type": "checkbox",
"id": "container_width",
"label": "Contain within container width",
"default": false
},
{ "type": "header", "content": "Header" },
{ "type": "text", "id": "heading", "label": "Heading", "default": "Shop the Feed" },
{ "type": "text", "id": "subheading", "label": "Subheading" },
{ "type": "header", "content": "Profile" },
{ "type": "image_picker", "id": "profile_image", "label": "Profile image" },
{ "type": "text", "id": "profile_name", "label": "Profile name", "default": "@Harmony" },
{ "type": "text", "id": "profile_tagline", "label": "Profile tagline", "info": "Shown in popup only" },
{ "type": "url", "id": "profile_url", "label": "Profile link" },
{ "type": "text", "id": "follow_button_label", "label": "Follow button label", "default": "Follow" },
{
"type": "select",
"id": "follow_button_style",
"label": "Follow button style",
"default": "outline",
"options": [
{ "value": "filled", "label": "Filled" },
{ "value": "outline", "label": "Outline" }
]
},
{ "type": "header", "content": "Shop button" },
{ "type": "text", "id": "shop_button_label", "label": "Shop button label", "default": "Shop the Look" },
{ "type": "header", "content": "Slider" },
{
"type": "range",
"id": "slides_per_view_desktop",
"label": "Slides per view — desktop",
"min": 1,
"max": 6,
"step": 1,
"default": 4
},
{
"type": "range",
"id": "slides_per_view_mobile",
"label": "Slides per view — mobile",
"min": 1,
"max": 3,
"step": 0.1,
"default": 1.2
},
{
"type": "range",
"id": "gap_desktop",
"label": "Gap — desktop",
"min": 0,
"max": 60,
"step": 2,
"unit": "px",
"default": 20
},
{
"type": "range",
"id": "gap_mobile",
"label": "Gap — mobile",
"min": 0,
"max": 40,
"step": 2,
"unit": "px",
"default": 12
},
{
"type": "select",
"id": "aspect_ratio",
"label": "Block aspect ratio",
"default": "3_4",
"options": [
{ "value": "1_1", "label": "1:1 Square" },
{ "value": "4_5", "label": "4:5 Portrait" },
{ "value": "3_4", "label": "3:4 Portrait" },
{ "value": "16_9", "label": "16:9 Landscape" },
{ "value": "9_16", "label": "9:16 Tall" },
{ "value": "3_2", "label": "3:2 Landscape" }
]
},
{ "type": "header", "content": "Section padding" },
{
"type": "range",
"id": "padding_top_desktop",
"label": "Padding top — desktop",
"min": 0,
"max": 150,
"step": 5,
"unit": "px",
"default": 60
},
{
"type": "range",
"id": "padding_bottom_desktop",
"label": "Padding bottom — desktop",
"min": 0,
"max": 150,
"step": 5,
"unit": "px",
"default": 60
},
{
"type": "range",
"id": "padding_top_mobile",
"label": "Padding top — mobile",
"min": 0,
"max": 100,
"step": 4,
"unit": "px",
"default": 32
},
{
"type": "range",
"id": "padding_bottom_mobile",
"label": "Padding bottom — mobile",
"min": 0,
"max": 100,
"step": 4,
"unit": "px",
"default": 32
}
],
"blocks": [
{
"type": "feed_item",
"name": "Feed item",
"settings": [
{ "type": "image_picker", "id": "image", "label": "Image" },
{ "type": "video", "id": "video", "label": "Video", "info": "Takes priority over image if set" },
{ "type": "header", "content": "Overlay" },
{
"type": "range",
"id": "overlay_opacity",
"label": "Overlay opacity",
"min": 0,
"max": 100,
"step": 5,
"unit": "%",
"default": 0
},
{ "type": "header", "content": "Products" },
{ "type": "product_list", "id": "products", "label": "Products", "limit": 4 }
]
}
],
"max_blocks": 12,
"presets": [
{
"name": "Insta feed",
"blocks": [{ "type": "feed_item" }, { "type": "feed_item" }, { "type": "feed_item" }, { "type": "feed_item" }]
}
]
}
{% endschema %}
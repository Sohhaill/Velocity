{{ 'media-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
#v-mediagrid-{{ section.id }} {
--v-mediagrid-columns-desktop: {{ section.settings.columns_desktop }};
--v-mediagrid-columns-mobile: {{ section.settings.columns_mobile }};
--v-mediagrid-gap-desktop: {{ section.settings.gap_desktop }}px;
--v-mediagrid-gap-mobile: {{ section.settings.gap_mobile }}px;
--v-mediagrid-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
--v-mediagrid-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
--v-mediagrid-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
--v-mediagrid-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
--v-mediagrid-height-desktop: {{ section.settings.block_height_desktop }}px;
--v-mediagrid-height-mobile: {{ section.settings.block_height_mobile }}px;
}
{%- endstyle -%}

<div
  class="v-mediagrid section-color-scheme--{{ section.settings.section_color_scheme.id }}{% if section.settings.container_width %} container-width{% endif %}"
  id="v-mediagrid-{{ section.id }}" data-v-mediagrid>
  <div class="v-mediagrid__grid v-mediagrid__hover--{{ section.settings.hover_effect | default: 'none' }}">
    {%- for block in section.blocks -%}
    {%- if block.type == 'media_item' -%}
    {% assign span_style = '' %}

    {% if block.settings.col_span_desktop > 0 %}
    {% assign span_style = span_style
    | append: '--col-span-desktop: '
    | append: block.settings.col_span_desktop
    | append: '; '
    %}
    {% endif %}
    {% if block.settings.row_span_desktop > 0 %}
    {% assign span_style = span_style
    | append: '--row-span-desktop: '
    | append: block.settings.row_span_desktop
    | append: '; '
    %}
    {% endif %}
    {% if block.settings.col_span_mobile > 0 %}
    {% assign span_style = span_style
    | append: '--col-span-mobile: '
    | append: block.settings.col_span_mobile
    | append: '; '
    %}
    {% endif %}
    {% if block.settings.row_span_mobile > 0 %}
    {% assign span_style = span_style
    | append: '--row-span-mobile: '
    | append: block.settings.row_span_mobile
    | append: '; '
    %}
    {% endif %}

    {% assign overlay_style = '--overlay-opacity-desktop: '
    | append: block.settings.overlay_opacity_desktop
    | default: 0
    | divided_by: 100.0
    | append: '; --overlay-opacity-mobile: '
    | append: block.settings.overlay_opacity_mobile
    | default: 0
    | divided_by: 100.0
    | append: ';'
    %}

    <div class="v-mediagrid__item" style="{{ span_style }}" {{ block.shopify_attributes }}>
      <div class="v-mediagrid__media">
        {%- comment -%} MOBILE - falls back to desktop {%- endcomment -%}
        <div class="v-mediagrid__media-wrap v-mediagrid__media-wrap--mobile">
          {%- if block.settings.video_mobile != blank -%}
          {{
          block.settings.video_mobile
          | video_tag:
          image_size: '1500x',
          muted: true,
          loop: true,
          autoplay: true,
          controls: false,
          class: 'v-mediagrid__video'
          }}
          {%- elsif block.settings.image_mobile != blank -%}
          {{
          block.settings.image_mobile
          | image_url: width: 3840
          | image_tag:
          loading: 'lazy',
          widths: '480,750,1000,1500,2000,3000,3840',
          sizes: '100vw',
          class: 'v-mediagrid__img'
          }}
          {%- elsif block.settings.video_desktop != blank -%}
          {{
          block.settings.video_desktop
          | video_tag:
          image_size: '1500x',
          muted: true,
          loop: true,
          autoplay: true,
          controls: false,
          class: 'v-mediagrid__video'
          }}
          {%- elsif block.settings.image_desktop != blank -%}
          {{
          block.settings.image_desktop
          | image_url: width: 3840
          | image_tag:
          loading: 'lazy',
          widths: '480,750,1000,1500,2000,3000,3840',
          sizes: '100vw',
          class: 'v-mediagrid__img'
          }}
          {%- else -%}
          <div class="placeholder-image">{{ 'placeholder-media.svg' | inline_asset_content }}</div>
          {%- endif -%}
        </div>

        <div class="v-mediagrid__media-wrap v-mediagrid__media-wrap--desktop">
          {%- if block.settings.video_desktop != blank -%}
          {{
          block.settings.video_desktop
          | video_tag:
          image_size: '3840x',
          muted: true,
          loop: true,
          autoplay: true,
          controls: false,
          class: 'v-mediagrid__video'
          }}
          {%- elsif block.settings.image_desktop != blank -%}
          {{
          block.settings.image_desktop
          | image_url: width: 3840
          | image_tag:
          loading: 'lazy',
          widths: '750,1100,1500,1920,2560,3200,3840',
          sizes: '100vw',
          class: 'v-mediagrid__img'
          }}
          {%- else -%}
          <div class="placeholder-image">{{ 'placeholder-media.svg' | inline_asset_content }}</div>
          {%- endif -%}
        </div>

        <div class="v-mediagrid__overlay" style="{{ overlay_style }}"></div>

        <div class="v-mediagrid__content">
          {%- if block.settings.heading != blank -%}
          <h3 class="v-mediagrid__heading" data-animate="fade-up" data-animate-delay="100">{{ block.settings.heading }}
          </h3>
          {%- endif -%}
          {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
          <a href="{{ block.settings.button_link }}" data-animate="fade-up" data-animate-delay="200"
            class="button {% if block.settings.button_style == 'outline' %}button--outline{% else %}button--filled{% endif %}">
            {{ block.settings.button_label }}
          </a>
          {%- endif -%}
        </div>
      </div>
    </div>
    {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
"name": "Media grid",
"class": "section-media-grid",
"settings": [
{
"type": "color_scheme",
"id": "section_color_scheme",
"label": "t:labels.color_scheme",
"default": "scheme-1"
},
{
"type": "checkbox",
"id": "container_width",
"label": "Contain within container width",
"default": false
},
{ "type": "header", "content": "Grid" },
{
"type": "range",
"id": "columns_desktop",
"label": "Columns - desktop",
"min": 1,
"max": 6,
"step": 1,
"default": 2
},
{
"type": "range",
"id": "columns_mobile",
"label": "Columns - mobile",
"min": 1,
"max": 3,
"step": 1,
"default": 2
},
{
"type": "range",
"id": "gap_desktop",
"label": "Column gap - desktop",
"min": 0,
"max": 60,
"step": 2,
"unit": "px",
"default": 24
},
{
"type": "range",
"id": "gap_mobile",
"label": "Column gap - mobile",
"min": 0,
"max": 40,
"step": 2,
"unit": "px",
"default": 12
},
{
"type": "range",
"id": "block_height_desktop",
"label": "Block height - desktop",
"min": 200,
"max": 900,
"step": 10,
"unit": "px",
"default": 500
},
{
"type": "range",
"id": "block_height_mobile",
"label": "Block height - mobile",
"min": 150,
"max": 700,
"step": 10,
"unit": "px",
"default": 350
},
{
"type": "select",
"id": "hover_effect",
"label": "Hover effect",
"default": "zoom",
"options": [
{ "value": "none", "label": "None" },
{ "value": "zoom", "label": "Zoom" },
{ "value": "lift", "label": "Lift" },
{ "value": "overlay-darken", "label": "Overlay darken" }
]
},
{ "type": "header", "content": "Section padding" },
{
"type": "range",
"id": "padding_top_desktop",
"label": "Padding top - desktop",
"min": 0,
"max": 150,
"step": 5,
"unit": "px",
"default": 60
},
{
"type": "range",
"id": "padding_bottom_desktop",
"label": "Padding bottom - desktop",
"min": 0,
"max": 150,
"step": 5,
"unit": "px",
"default": 60
},
{
"type": "range",
"id": "padding_top_mobile",
"label": "Padding top - mobile",
"min": 0,
"max": 100,
"step": 4,
"unit": "px",
"default": 32
},
{
"type": "range",
"id": "padding_bottom_mobile",
"label": "Padding bottom - mobile",
"min": 0,
"max": 100,
"step": 4,
"unit": "px",
"default": 32
}
],
"blocks": [
{
"type": "media_item",
"name": "Media item",
"settings": [
{ "type": "header", "content": "Media - desktop" },
{ "type": "image_picker", "id": "image_desktop", "label": "Image" },
{ "type": "video", "id": "video_desktop", "label": "Video", "info": "Takes priority over image if set" },
{ "type": "header", "content": "Media - mobile" },
{
"type": "image_picker",
"id": "image_mobile",
"label": "Image",
"info": "Falls back to desktop image if empty"
},
{ "type": "video", "id": "video_mobile", "label": "Video", "info": "Falls back to desktop video if empty" },
{ "type": "header", "content": "Overlay" },
{
"type": "range",
"id": "overlay_opacity_desktop",
"label": "Overlay opacity - desktop",
"min": 0,
"max": 100,
"step": 5,
"unit": "%",
"default": 30
},
{
"type": "range",
"id": "overlay_opacity_mobile",
"label": "Overlay opacity - mobile",
"min": 0,
"max": 100,
"step": 5,
"unit": "%",
"default": 30
},
{ "type": "header", "content": "Grid span" },
{
"type": "range",
"id": "col_span_desktop",
"label": "Column span - desktop",
"info": "0 = normal single column",
"min": 0,
"max": 6,
"step": 1,
"default": 0
},
{
"type": "range",
"id": "row_span_desktop",
"label": "Row span - desktop",
"info": "0 = normal single row",
"min": 0,
"max": 4,
"step": 1,
"default": 0
},
{
"type": "range",
"id": "col_span_mobile",
"label": "Column span - mobile",
"info": "0 = normal single column",
"min": 0,
"max": 3,
"step": 1,
"default": 0
},
{
"type": "range",
"id": "row_span_mobile",
"label": "Row span - mobile",
"info": "0 = normal single row",
"min": 0,
"max": 4,
"step": 1,
"default": 0
},
{ "type": "header", "content": "Content" },
{ "type": "text", "id": "heading", "label": "Heading" },
{ "type": "header", "content": "Button" },
{ "type": "text", "id": "button_label", "label": "Button label" },
{ "type": "url", "id": "button_link", "label": "Button link" },
{
"type": "select",
"id": "button_style",
"label": "Button style",
"default": "filled",
"options": [
{ "value": "filled", "label": "Filled" },
{ "value": "outline", "label": "Outline" },
{ "value": "glass", "label": "Glass effect" }

]
}
]
}
],
"max_blocks": 12,
"presets": [
{
"name": "Media grid",
"blocks": [{ "type": "media_item" }, { "type": "media_item" }]
}
]
}
{% endschema %}